    <script>
 
          
  



document.addEventListener('DOMContentLoaded', () => {
    const hoverAccountInfo = document.querySelector('.hover-accountinfo');
    const showAccountBtn = document.querySelector('.show-account');

    // Show hover-accountinfo when show-account is clicked
    showAccountBtn.addEventListener('click', (event) => {
        event.stopPropagation(); // Prevent the click from bubbling up
        hoverAccountInfo.classList.remove('hidden');
    });

    // Hide hover-accountinfo when clicking outside of it
    document.addEventListener('click', (event) => {
        if (
            !hoverAccountInfo.contains(event.target) &&
            !showAccountBtn.contains(event.target)
        ) {
            hoverAccountInfo.classList.add('hidden');
        }
    });
});


    </script>
     <script src="../script/account.js"></script>
